<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AoCEditor.Infrastructure</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport-generated stubs are unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="../Shared/Shared.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <EmbeddedResource Include="Storage/Migrations/*.sql" LogicalName="Migrations/%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="AoCEditor.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Specs" />
  </ItemGroup>
</Project>
