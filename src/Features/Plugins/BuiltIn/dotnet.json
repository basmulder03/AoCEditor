{
  "schemaVersion": 1,
  "id": "dotnet",
  "name": ".NET (C#)",
  "extensions": [".cs"],
  "templateFiles": {
    "Solution.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>net10.0</TargetFramework>\n    <Nullable>enable</Nullable>\n    <ImplicitUsings>enable</ImplicitUsings>\n  </PropertyGroup>\n</Project>\n",
    "Program.cs": "var data = Console.In.ReadToEnd();\nConsole.WriteLine(Part1(data));\nConsole.WriteLine(Part2(data));\n\nstatic object? Part1(string data) => null;\n\nstatic object? Part2(string data) => null;\n"
  },
  "toolchain": { "executables": ["dotnet"] },
  "compile": { "command": ["{toolchain}", "build", "{workdir}", "-c", "Release", "--nologo"] },
  "run": { "command": ["{toolchain}", "run", "--project", "{workdir}", "-c", "Release", "--no-build"], "input": "stdin" }
}
