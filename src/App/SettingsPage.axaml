<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AoCEditor"
             x:Class="AoCEditor.SettingsPage"
             x:DataType="local:SettingsPage">
  <StackPanel Spacing="{DynamicResource Space2}">
    <TextBlock Classes="heading" Text="Settings" />
    <TextBlock Text="Theme" />
    <ComboBox x:Name="ThemeBox" MinWidth="200" SelectedIndex="0"
              AutomationProperties.Name="Theme" SelectionChanged="OnThemeChanged" />

    <CheckBox x:Name="DebugModeBox" Content="Debug mode" AutomationProperties.Name="Debug mode"
              IsCheckedChanged="OnDebugModeChanged" />
    <TextBlock x:Name="DebugModeNote" Classes="muted" TextWrapping="Wrap" IsVisible="False"
               Text="Debug mode is on for this run (--debug or AOCEDITOR_DEBUG)." />

    <StackPanel x:Name="AccountPanel" Spacing="{DynamicResource Space2}" Margin="{DynamicResource InsetTopMd}">
      <TextBlock Classes="heading" Text="Account" />
      <TextBlock x:Name="StatusText" AutomationProperties.Name="Sign-in status" />
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
        <Button x:Name="SignInButton" Content="Sign in" AutomationProperties.Name="Sign in" Click="OnSignInClick" />
        <Button x:Name="SignOutButton" Content="Sign out" AutomationProperties.Name="Sign out" Click="OnSignOutClick" />
        <Button x:Name="PasteToggle" Content="Paste a token instead" AutomationProperties.Name="Paste a token instead" Click="OnPasteToggleClick" />
      </StackPanel>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.Name="Sign-in message" />
      <StackPanel x:Name="PastePanel" IsVisible="False" Spacing="{DynamicResource Space2}" MaxWidth="560">
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Sign in to Advent of Code in your web browser. Open the developer tools (F12), go to Application or Storage, then Cookies, and copy the value of the cookie named session. Paste it here." />
        <TextBox x:Name="PasteBox" PasswordChar="*" PlaceholderText="session cookie value"
                 AutomationProperties.Name="Session cookie value" />
        <Button x:Name="UseTokenButton" Content="Use this token" AutomationProperties.Name="Use this token" Click="OnUseTokenClick" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
