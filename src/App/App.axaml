<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AoCEditor.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://UiKit/Tokens/Colors.axaml" />
        <ResourceInclude Source="avares://UiKit/Tokens/Metrics.axaml" />
        <ResourceInclude Source="avares://UiKit/Tokens/Brushes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://UiKit/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
